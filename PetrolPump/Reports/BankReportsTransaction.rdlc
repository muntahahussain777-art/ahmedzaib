                  <FontSize>12pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Sum(
    IIF(Fields!TransactionType.Value = "In", Fields!Amount.Value, 0),
    "DataSet1"
)
-
Sum(
    IIF(Fields!TransactionType.Value = "Out", ABS(Fields!Amount.Value), 0),
    "DataSet1"
)</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>12pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
